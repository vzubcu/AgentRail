# ═══════════════════════════════════════════════════════════ #
# AgentRail — Environment Configuration #
# ═══════════════════════════════════════════════════════════ #

# ──────────── MOD 1: Full Docker ──────────── #
# No .env needed — everything is in docker-compose.yml
# Command: docker compose up -d

# ──────────── MOD 2: Hybrid (Postgres in Docker, app local) ──────────── #
# 1. Start only Postgres:
# docker compose -f docker-compose.db.yml up -d
# 2. Run the app locally:
# npm run build && npm start
AGENTRAIL_SECRETS_DATABASE_URL=postgresql://agentrail:agentrail_dev_password@localhost:5432/agentrail
AGENTRAIL_SECRET_ENCRYPTION_KEY=agentrail-local-dev-secret-key
AGENTRAIL_SAAS=1
REDIS_URL=redis://redis:6379
AGENTRAIL_REDIS_URL=redis://redis:6379

# ──────────── MOD 3: Fully local (no Docker, no Postgres) ──────────── #
# Everything is saved to JSON files in .agentrail/
AGENTRAIL_SAAS=1

# ──────────── Common options ──────────── #
AGENTRAIL_ADMIN_EMAIL=admin@agentrail.com
AGENTRAIL_ADMIN_PASSWORD=your-admin-password
AGENTRAIL_DEBUG_TRACE=1
AGENTRAIL_PROVIDER_TIMEOUT_MS=30000
AGENTRAIL_ALLOW_INSECURE_PROXY_TLS=1
KIMI_API_KEY=your_kimi_api_key_here

# Port/Host (optional, default: 42424 / 127.0.0.1)
PORT=42424
HOST=127.0.0.1
AGENTRAIL_HEDGE_DELAY_MS=1000